{
	"name": "mateusgetulio/wp-delivery-trace",
	"description": "WordPress plugin that stores form leads first, delivers them to a CRM webhook, and traces every attempt.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.0",
		"ext-mbstring": "*"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"DeliveryTrace\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"DeliveryTrace\\Tests\\": "tests/"
		}
	},
	"config": {
		"platform": {
			"php": "8.0.30"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
		"phpcs": "phpcs",
		"test": "phpunit"
	}
}
